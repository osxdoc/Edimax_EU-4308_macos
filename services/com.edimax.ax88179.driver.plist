<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.edimax.ax88179.driver</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/edimax_driver</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ExitTimeOut</key>
    <integer>15</integer>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/edimax_driver.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/edimax_driver.log</string>
</dict>
</plist>
